{
  "name": "collagejs-adapter",
  "private": true,
  "author": {
    "name": "José Pablo Ramírez Vargas",
    "email": "webJose@gmail.com",
    "url": "https://github.com/webJose"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "build:adapter": "npm run build --workspace=packages/adapter",
    "build:adapters": "npm run build --workspace=packages/svelte --workspace=packages/react --workspace=packages/vue",
    "build:packages": "npm run build:adapter && npm run build:adapters",
    "build": "npm run build:packages",
    "test": "npm run test --workspaces",
    "test:cicd": "npx playwright install && npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "check": "npm run check --workspaces",
    "clean": "npm run clean --workspaces"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9"
  }
}
