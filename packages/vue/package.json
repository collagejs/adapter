{
  "name": "@collagejs/vue",
  "version": "0.0.1",
  "description": "VueJS integration for the CollageJS micro-frontend library",
  "keywords": [
    "vue",
    "collage",
    "collage-js",
    "collagejs",
    "micro-frontend",
    "mfe",
    "single-spa"
  ],
  "homepage": "https://collagejs.dev",
  "bugs": {
    "url": "https://github.com/collagejs/adapter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collagejs/adapter.git"
  },
  "license": "MIT",
  "author": {
    "email": "webJose@gmail.com",
    "name": "José Pablo Ramírez Vargas",
    "url": "https://github.com/webJose"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo node_modules/.tmp",
    "check": "vue-tsc --noEmit",
    "build:types": "vue-tsc -p ./tsconfig.build.json",
    "build": "npm run clean && vue-tsc -b && vite build && npm run build:types && publint",
    "preview": "vite preview",
    "test": "echo No tests yet"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vue-tsc": "^3.3.5"
  },
  "peerDependencies": {
    "@collagejs/core": "0.x || 1.x",
    "vue": ">=3.3.0 <4.0.0"
  },
  "dependencies": {
    "@collagejs/adapter": "0.x || 1.x"
  }
}
