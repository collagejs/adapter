{
  "name": "@collagejs/svelte",
  "version": "0.5.1",
  "description": "Svelte v5 integration for the CollageJS micro-frontend library",
  "keywords": [
    "svelte",
    "collage",
    "collage-js",
    "collagejs",
    "micro-frontend",
    "mfe",
    "single-spa"
  ],
  "homepage": "https://collagejs.dev",
  "bugs": {
    "url": "https://github.com/collagejs/adapter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collagejs/adapter.git"
  },
  "license": "MIT",
  "author": {
    "email": "webJose@gmail.com",
    "name": "José Pablo Ramírez Vargas",
    "url": "https://github.com/webJose"
  },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!dist/testing",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "dev": "vite dev",
    "clean": "rimraf dist tsconfig.tsbuildinfo .svelte-kit",
    "build": "vite build && npm run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "test:cicd": "npx playwright install && npm run test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.67.0",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@vitest/browser-playwright": "^4.0.15",
    "playwright": "^1.57.0",
    "publint": "^0.3.15",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.0.15",
    "vitest-browser-svelte": "^3.0.0"
  },
  "peerDependencies": {
    "@collagejs/core": "0.x || 1.x",
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@collagejs/adapter": "0.2.0"
  }
}
